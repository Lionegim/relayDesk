# Copier en .env puis renseigner.
MISTRAL_API_KEY=
# Client OAuth Google de type « Application de bureau » (voir docs/gmail.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel
MISTRAL_MODEL=mistral-small-latest
OWNER_NAME=Jean-Hugues
HOST=127.0.0.1
PORT=4310
# Base SQLite et clé de chiffrement générée (data/secret.key) si RELAY_SECRET_KEY est vide
DATA_DIR=./data
RELAY_SECRET_KEY=
# 0 pour démarrer sans les messages d'exemple (à faire avant le premier lancement)
DEMO_DATA=1
SYNC_INTERVAL_MS=60000
