# Hébergement de TEST : aucun mail réel, aucun connecteur/IA activé.
# Le contact ACME est volontairement omis : aucune adresse personnelle n'est transmise.
{
	acme_ca {$ACME_CA}
	admin off
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
				uri delete
				headers delete
				resp_headers delete
			}
		}
	}
}

{$RELAY_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Relay-Environment "test-only"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy relay:4310
}

{$RELAY_IDENTITY_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Relay-Environment "test-only"
		-Server
	}
	request_body {
		max_size 1MB
	}
	# Aucun master realm, console/API d'administration, compte libre-service ou endpoint de gestion public.
	@oidc path /realms/relay-test/.well-known/* /realms/relay-test/protocol/openid-connect/* /realms/relay-test/login-actions/* /resources/*
	handle @oidc {
		reverse_proxy keycloak:8080
	}
	handle {
		respond "Not found" 404
	}
}
