# Variables de la compose d'identité de TEST (aucun secret ici). Copier hors dépôt, p. ex. /etc/relay-desk-test/identity.env (root, 0600).
IDENTITY_DOMAIN=auth.relay.migeoncorp.fr
# Sous-réseau fixe du réseau « backend » où se trouve Caddy (seul proxy de confiance pour X-Forwarded-*).
IDENTITY_TRUSTED_PROXIES=A_RENSEIGNER
IDENTITY_SECRETS_DIR=/etc/relay-desk-test/identity
