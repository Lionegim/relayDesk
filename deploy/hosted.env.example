# Modèle du fichier d'environnement hébergé. À copier HORS du dépôt : /etc/relay-desk/hosted.env (root, mode 0600).
# Aucun secret ici : chaque secret est un fichier dans RELAY_SECRETS_DIR (voir docs/operations.md).
# Les valeurs A_RENSEIGNER sont refusées par « node deploy/preflight.mjs ».

# Étiquette immuable de l'image : empreinte du commit construit (git rev-parse --short HEAD) ou vX.Y.Z. Jamais latest.
RELAY_IMAGE_TAG=A_RENSEIGNER

# Domaine choisi (à confirmer) et origine publique correspondante, sans barre finale.
RELAY_DOMAIN=A_RENSEIGNER
PUBLIC_BASE_URL=https://A_RENSEIGNER

# Certificats : adresse de contact ACME. Première recette sur l'autorité de test, puis retirer ACME_CA (production).
ACME_EMAIL=A_RENSEIGNER
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Répertoires hôtes EXISTANTS, hors dépôt, disjoints.
# Secrets de l'application : root:root 0700 ; fichiers uid 1000, mode 0400.
RELAY_SECRETS_DIR=/etc/relay-desk/secrets
# Données : uid 1000, mode 0700. Une génération par restauration (…/data/AAAAMMJJ-n), basculée explicitement.
RELAY_DATA_DIR=/srv/relay-desk/data/A_RENSEIGNER

# Sauvegardes : archives/ (chiffrées) et status/, uid 1000, mode 0700.
RELAY_BACKUP_DIR=/srv/relay-desk/backups
# Clé de sauvegarde : distincte du coffre, montée seulement dans le service « backup » (uid 1000, 0400 ; dossier root 0700).
RELAY_BACKUP_KEY_FILE=/etc/relay-desk/backup/backup.key
# tmpfs du snapshot en clair (base entière + 25 % + 64 Mio) et mémoire du service de sauvegarde (tmpfs + 256 Mio au moins).
RELAY_BACKUP_TMPFS_SIZE=1g
RELAY_BACKUP_MEM_LIMIT=1536m

# Keycloak (à configurer plus tard, voir docs/auth.md et docs/operations.md).
AUTH_ISSUER=https://A_RENSEIGNER/realms/A_RENSEIGNER
AUTH_OWNER_SUB=A_RENSEIGNER
AUTH_MFA_ACR=relay-mfa

# Microsoft : consumers (compte personnel), organizations, common ou identifiant du tenant.
# Préparation hors réseau jusqu’à la bascule validée. Définir les identités exactes avant activation.
RELAY_CONNECTORS_ENABLED=false
RELAY_AI_ENABLED=false
RELAY_ALLOWED_ACCOUNTS=
MICROSOFT_TENANT=common

# Notifications fournisseurs optionnelles (voir docs/mail-push.md). Aucun secret ici.
GMAIL_PUSH_ENABLED=false
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_SUBSCRIPTION=
GMAIL_PUSH_SERVICE_ACCOUNT=
OUTLOOK_PUSH_ENABLED=false
# Si Outlook push est activé, MICROSOFT_TENANT doit être le GUID de l’annuaire.
