# Fichier d'environnement de Compose pour le mode local de TEST (compose.dev.yaml).
# Passé avec --env-file, il remplace la lecture automatique du .env du projet : le .env réel n'est jamais lu.
# Ne contient aucun secret ; la clé de test est générée dans un volume Docker dédié.
COMPOSE_PROJECT_NAME=relay-desk-dev
